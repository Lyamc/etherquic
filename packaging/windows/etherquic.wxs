<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-machine installer for the etherquic host service and the etherquic app.
  WiX 5:  see build-msi.ps1, which stages the files and runs wix build.

  Files land in Program Files\etherquic-setup. The payload is then installed by
  the existing flow: msi-setup.ps1 optionally runs membrane\install-membrane-ndis.ps1
  and then etherquic-setup.exe (unattended, attended or saved mode) with that directory as its payload,
  which copies the host to Program Files\etherquic and creates etherquic-service.
  Uninstall runs etherquic-setup.exe in uninstall mode (host.conf is kept).

  Properties (msiexec ... NAME=value):
    MEMBRANE=1|0|force  install the Membrane NDIS filter (default 1: skipped when already running). Needs Secure Boot off;
                       turning test signing on asks for a reboot, the MSI does not reboot.
    ACCESS=unattended|attended|<empty>   empty keeps the saved mode (fresh install: attended).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="etherquic"
           Manufacturer="EtherQuic"
           Version="$(var.ProductVersion)"
           UpgradeCode="5B0E7F3C-2A41-4C8E-9D6B-71E4A3C90F12"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="MEMBRANE" Value="1" />
    <Property Id="ACCESS" Secure="yes" />
    <Property Id="ARPCOMMENTS" Value="etherquic host service, Membrane L2 filter and the etherquic app" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="etherquic-setup" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**">
        <Exclude Files="$(var.Stage)\etherquic.exe" />
      </Files>
      <Component Id="AppExe" Bitness="always64">
        <File Id="AppExe" Source="$(var.Stage)\etherquic.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ProgramMenuFolder" Bitness="always64">
      <Shortcut Id="AppShortcut" Name="etherquic" Description="Find and play etherquic hosts"
                Target="[INSTALLFOLDER]etherquic.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM" Key="Software\EtherQuic\etherquic" Name="StartMenu"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="etherquic" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <SetProperty Id="EqInstall" Before="EqInstall" Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Membrane &quot;[MEMBRANE]&quot; -Access &quot;[ACCESS]&quot;" />
    <CustomAction Id="EqInstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />

    <SetProperty Id="EqUninstall" Before="EqUninstall" Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Uninstall" />
    <CustomAction Id="EqUninstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="EqInstall" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="EqUninstall" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>